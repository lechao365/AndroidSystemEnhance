+	 *
+	 * 为什么只发射 END 而不发射 ERROR：
+	 *   - USB_STOR_TRANSPORT_NO_SENSE 表示传输本身成功了，但设备返回了
+	 *     CHECK CONDITION 状态，sense 数据已准备好供上层读取
+	 *   -这不是 USB 层面的错误，只是 SCSI 层面的异常状态
+	 */
 	if (result == USB_STOR_TRANSPORT_NO_SENSE) {
 		srb->result = SAM_STAT_CHECK_CONDITION;
 		last_sector_hacks(us, srb);
+		notif_data.result = result;
+		usb_stor_notifier_call(us, USB_STOR_NOTIFIER_TRANSPORT_END, &notif_data);
 		return;
 	}
 
@@ -893,6 +1004,16 @@ void usb_stor_invoke_transport(struct scsi_cmnd *srb, struct us_data *us)
 		srb->result = DID_ERROR << 16;
 
 	last_sector_hacks(us, srb);
+	/*
+	 * 通知：传输结束（成功或失败，但不是 aborted/error/no_sense）
+	 *
+	 * 为什么在此处发射 TRANSPORT_END：
+	 *   这是正常处理路径的出口点。无论是 USB_STOR_TRANSPORT_GOOD 还是
+	 *   USB_STOR_TRANSPORT_FAILED（需要 auto-sense），都在此处统一发射 END。
+	 *   duration_ns 和 data_direction/datalen 已在前面填充到 notif_data。
+	 */
+	notif_data.result = result;
+	usb_stor_notifier_call(us, USB_STOR_NOTIFIER_TRANSPORT_END, &notif_data);
 	return;
 
 	/*
@@ -927,6 +1048,16 @@ void usb_stor_invoke_transport(struct scsi_cmnd *srb, struct us_data *us)
 	}
 	clear_bit(US_FLIDX_RESETTING, &us->dflags);
 	last_sector_hacks(us, srb);
+	/*
+	 * 通知：USB 设备重置
+	 *
+	 * 为什么在此处发射 RESET notifier：
+	 *   Handle_Errors 标签是所有传输异常的汇聚点（aborted / transport error /
+	 *   auto-sense failure）。此处执行 port reset 或 transport reset 恢复设备。
+	 *   vendor_lechao_usbd 需要记录每次 reset 事件用于统计设备稳定性。
+	 *   notif_data 中的 result 是原始传输返回值（非 reset 操作本身的返回值）。
+	 */
+	usb_stor_notifier_call(us, USB_STOR_NOTIFIER_RESET, &notif_data);
