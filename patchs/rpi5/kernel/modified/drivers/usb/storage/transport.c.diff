+	 *
+	 * 为什么在此处连续发射 TRANSPORT_ERROR + TRANSPORT_END：
+	 *   - TRANSPORT_ERROR 表示 USB 层面的传输失败（如 URB submit 失败）
+	 *   - TRANSPORT_END 是必须配对的结束通知，无论成功还是失败
+	 *   - vendor_lechao_usbd 在 ERROR 时会标记 last_transport_error=true，
+	 *     END 时检查该标志决定是否计入有效传输
+	 */
 	if (result == USB_STOR_TRANSPORT_ERROR) {
 		usb_stor_dbg(us, "-- transport indicates error, resetting\n");
 		srb->result = DID_ERROR << 16;
+		notif_data.result = result;
+		usb_stor_notifier_call(us, USB_STOR_NOTIFIER_TRANSPORT_ERROR, &notif_data);
+		usb_stor_notifier_call(us, USB_STOR_NOTIFIER_TRANSPORT_END, &notif_data);
 		goto Handle_Errors;
 	}
 
-	/* if the transport provided its own sense data, don't auto-sense */
+	/*
