 	 */
 	if (test_bit(US_FLIDX_TIMED_OUT, &us->dflags)) {
 		usb_stor_dbg(us, "-- command was aborted\n");
 		srb->result = DID_ABORT << 16;
+		notif_data.result = srb->result;
+		usb_stor_notifier_call(us, USB_STOR_NOTIFIER_TRANSPORT_END, &notif_data);
 		goto Handle_Errors;
 	}
 
