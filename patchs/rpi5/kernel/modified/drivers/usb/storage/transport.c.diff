@@ -605,32 +665,83 @@ void usb_stor_invoke_transport(struct scsi_cmnd *srb, struct us_data *us)
 {
 	int need_auto_sense;
 	int result;
+	ktime_t ts_start;
+	u64 transport_duration_ns = 0;
+	struct usb_stor_notifier_data notif_data = { .us = us, .srb = srb };
+
+	ts_start = ktime_get();
+
+	/*
+	 * 通知：传输开始
+	 *
+	 * 为什么在此处发射 TRANSPORT_START notifier：
+	 *   这是 usb_stor_invoke_transport 的入口，在调用 transport() 之前。
+	 *   vendor_lechao_usbd 监控驱动需要知道每次传输的开始时间来计算延迟。
+	 *   ts_start 同时用于 duration_ns 计算，与 notifier 的时间戳独立。
+	 */
+	usb_stor_notifier_call(us, USB_STOR_NOTIFIER_TRANSPORT_START, &notif_data);
 
 	/* send the command to the transport layer */
 	scsi_set_resid(srb, 0);
+	us->last_fault_type = 0;
+	us->last_fault_status = 0;
 	result = us->transport(srb, us);
 
+	transport_duration_ns = ktime_to_ns(ktime_sub(ktime_get(), ts_start));
+
+	notif_data.duration_ns = transport_duration_ns;
+	notif_data.data_direction = srb->sc_data_direction == DMA_FROM_DEVICE ? 1 :
+				    srb->sc_data_direction == DMA_TO_DEVICE ? 2 : 0;
+	notif_data.data_len = scsi_bufflen(srb);
+
 	/*
-	 * if the command gets aborted by the higher layers, we need to
-	 * short-circuit all other processing
+	 * 命令被上层 abort 处理
+	 *
+	 * 为什么在此处发射 TRANSPORT_END（aborted）：
+	 *   - US_FLIDX_TIMED_OUT 表示 SCSI midlayer 已超时并触发 abort
+	 *   - 即使传输被中断，也必须发射 END 来配对 START，确保监控驱动的
