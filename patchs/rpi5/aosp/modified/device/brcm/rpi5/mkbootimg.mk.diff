diff --git a/mkbootimg.mk b/mkbootimg.mk
index 78ea22f..3cb7cbf 100644
--- a/mkbootimg.mk
+++ b/mkbootimg.mk
@@ -8,7 +8,17 @@ DEVICE_PATH := device/brcm/rpi5
 KERNEL_PATH := device/brcm/rpi5-kernel
 
 RPI_BOOT_OUT := $(PRODUCT_OUT)/rpiboot
-$(RPI_BOOT_OUT): $(INSTALLED_RAMDISK_TARGET)
+
+# 所有 boot 分区源文件 —— 任一变化都应触发 rpiboot 重建
+RPI_BOOT_SRCS := \
+	$(INSTALLED_RAMDISK_TARGET) \
+	$(wildcard $(DEVICE_PATH)/boot/*) \
+	$(KERNEL_PATH)/Image \
+	$(wildcard $(KERNEL_PATH)/bcm2712*-rpi-*.dtb) \
+	$(wildcard $(KERNEL_PATH)/overlays/*.dtbo)
+
+$(RPI_BOOT_OUT): $(RPI_BOOT_SRCS)
+	$(call pretty,"Updating rpiboot from: $?")
 	mkdir -p $(RPI_BOOT_OUT)
 	mkdir -p $(RPI_BOOT_OUT)/overlays
 	cp $(DEVICE_PATH)/boot/* $(RPI_BOOT_OUT)
