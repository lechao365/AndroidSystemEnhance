# lechao_lciod —— IO 控制器的系统服务守护进程
#   这是一个系统级守护进程（位于 /system/bin），提供 IO 控制能力给上层应用
#   通过 Binder 与 iod_hal（vendor 端）通信，自身也以 service_manager 形式注册为系统服务

# 声明 lechao_lciod 为 SELinux domain
type lechao_lciod, domain;
# 声明 lechao_lciod 可执行文件的类型标签（用于 file_contexts 中匹配 /system/bin/lechao_lciod）
type lechao_lciod_exec, exec_type, file_type;

# 标记为 init 启动的守护进程域 —— 使得 init 进程可以向此域转换（domain transition）
#   即：init 执行 lechao_lciod_exec → SELinux 自动切换到 lechao_lciod domain
init_daemon_domain(lechao_lciod)

# 标记为 HAL 客户端域 —— 允许它使用 Android HAL 客户端相关权限
typeattribute lechao_lciod halclientdomain;
# 允许使用 vendor binder —— iod 是 system 端进程，iod_hal 是 vendor 端进程
#   跨 partition 通信必须使用 vndbinder 而非普通 binder
vndbinder_use(lechao_lciod)
# 允许 iod 通过 Binder 调用 iod_hal —— 实现 iod → iod_hal 的 RPC 调用
binder_call(lechao_lciod, lechao_lciod_hal)
# 允许 iod 在 service_manager 中查找 iod_hal 服务 —— 即 iod 启动时通过
#   IServiceManager::getService("vendor.lechao.lciod.IIoHal/default") 找到 HAL
allow lechao_lciod lechao_lciod_hal_service:service_manager find;

# 允许 iod 通过 /dev/binder 与 servicemanager 通信（注册 system 服务时需要）
binder_use(lechao_lciod, servicemanager)
allow lechao_lciod binder_device:chr_file rw_file_perms;

# 允许 iod 使用 syslog（capability2）—— 用于日志输出，方便调试
#   capability2 是 Linux capability 的扩展集，syslog 对应 CAP_SYSLOG
allow lechao_lciod self:capability2 syslog;

# 允许 iod 将自己的服务注册到 service_manager —— 这样客户端可以通过
#   IServiceManager::getService("system.lechao.lciod.IIoService/default") 找到 iod
allow lechao_lciod lciod_service:service_manager add;

# lciod_service 作为服务类型（service_manager_type），供其他域查找/使用
type lciod_service, service_manager_type;
