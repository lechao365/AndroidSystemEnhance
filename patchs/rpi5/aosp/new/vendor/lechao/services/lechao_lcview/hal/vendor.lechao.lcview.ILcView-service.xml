<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  vendor.lechao.lcview.ILcView-service.xml — VINTF Manifest 声明
  所属模块：LcView 事件日志系统 — HAL 层
  设计目的：在 VINTF（Vendor Interface）清单中声明
    vendor.lechao.lcview AIDL HAL 服务的存在。
  这是 Android Treble（Project Treble）架构的要求：
    设备的 vendor 分区必须通过 VINTF manifest 声明其提供的 HAL 服务，
    使 system 分区（framework）能够通过 VINTF 接口查询机制
    发现并访问这些服务，实现 vendor/system 解耦。
    
  manifest 属性：
    version="1.0" — VINTF manifest 格式版本
    type="device" — 设备端 manifest（区别于 framework manifest）
  hal 属性：
    format="aidl" — 接口格式为 AIDL（非 HIDL）
    name="vendor.lechao.lcview" — AIDL 包名（与 ILcView.aidl 的 package 一致）
  fqname 格式：接口名/实例名
    ILcView/default — 接口名/默认实例
    此名称应与 .rc 中的 interface 声明和代码中的注册名匹配
  ============================================================
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>vendor.lechao.lcview</name>
        <version>1</version>
        <fqname>ILcView/default</fqname>
    </hal>
</manifest>
