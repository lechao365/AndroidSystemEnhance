diff --git a/drivers/mmc/core/block.c b/drivers/mmc/core/block.c
--- a/drivers/mmc/core/block.c
+++ b/drivers/mmc/core/block.c
@@ -40,6 +40,7 @@
 #include <linux/pm_runtime.h>
 #include <linux/idr.h>
 #include <linux/debugfs.h>
+#include <linux/ktime.h>
 
 #include <linux/mmc/ioctl.h>
 #include <linux/mmc/card.h>
@@ -57,6 +58,14 @@
 #include "crypto.h"
 #include "host.h"
 #include "bus.h"
 #include "mmc_ops.h"
+#include "lechao_sd_notifier.h"
+
+/* Lechao: 全局 SD/MMC 块层健康事件原子 notifier 链头——block.c 定义并导出，
+ * lciod_sd 模块经 lechao_sd_notifier_register 订阅块请求完成 / card busy
+ * 卡死事件（发射点位于 blk-mq 完成路径与 card busy 轮询，atomic 链回调
+ * 不可睡眠，仅做赋值/累加）。 */
+ATOMIC_NOTIFIER_HEAD(lechao_sd_nh);
+EXPORT_SYMBOL_GPL(lechao_sd_nh);
 #include "quirks.h"
 #include "sd_ops.h"
@@ -2078,5 +2087,16 @@ static int mmc_blk_card_busy(struct mmc_card *card, struct request *req)
 	if (mmc_card_mmc(card) && cb_data.status & R1_EXCEPTION_EVENT)
 		mqrq->brq.cmd.resp[0] |= R1_EXCEPTION_EVENT;
 
+	/* Lechao: card busy 轮询超时或错误位置位 → 发射 STUCK（携带 card），
+	 * 供 lciod_sd 触发按 sd_bus_speed 逐级剥 caps 降档。atomic 上下文。 */
+	if (err) {
+		struct lechao_sd_notifier_data nd = {0};
+
+		nd.card = card;
+		nd.category = LECHAO_SD_EVENT_STUCK;
+		nd.err = err;
+		lechao_sd_notify(&nd);
+	}
+
 	return err;
 }
@@ -2092,7 +2112,18 @@ static void mmc_blk_mq_complete_rq(struct mmc_queue *mq, struct request *req)
 static void mmc_blk_mq_complete_rq(struct mmc_queue *mq, struct request *req)
 {
 	struct mmc_queue_req *mqrq = req_to_mmc_queue_req(req);
 	unsigned int nr_bytes = mqrq->brq.data.bytes_xfered;
+	/* Lechao: 块请求完成打点——duration 取 now - req->start_time_ns，
+	 * 携带字节/方向，供 lciod_sd 做 10s 窗聚合（atomic 上下文）。 */
+	struct lechao_sd_notifier_data nd = {0};
+
+	nd.card = mq->card;
+	nd.category = LECHAO_SD_EVENT_COMPLETE;
+	nd.direction = (rq_data_dir(req) == WRITE) ? LECHAO_SD_DIR_WRITE :
+						     LECHAO_SD_DIR_READ;
+	nd.bytes = nr_bytes;
+	nd.duration_ns = ktime_get_ns() - req->start_time_ns;
+	lechao_sd_notify(&nd);
 
 	if (req_op(req) == REQ_OP_WRITE)
 		mq->pending_writes--;
