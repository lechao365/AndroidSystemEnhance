+	uas_emit(devinfo, USB_STOR_NOTIFIER_TRANSPORT_START, cmnd, 0, 0);
 zombie:
 	spin_unlock_irqrestore(&devinfo->lock, flags);
 	return 0;
@@ -749,6 +894,16 @@ static int uas_eh_abort_handler(struct scsi_cmnd *cmnd)
 
 	spin_unlock_irqrestore(&devinfo->lock, flags);
 
+	/*
+	 * 命令被 SCSI 上层 abort（已置 COMMAND_ABORTED 并解除 URB 引用）
+	 *
+	 * 为什么在此打点：
+	 *   - abort 意味着命令未按正常状态机收敛，属于传输异常，需以
+	 *     -ECANCELED 通知监控驱动收敛该命令的状态机
+	 *   - 置于解锁后（进程上下文，无自旋锁约束），atomic 链亦可安全调用
+	 */
+	uas_emit(devinfo, USB_STOR_NOTIFIER_TRANSPORT_ERROR, cmnd, -ECANCELED, -ECANCELED);
+
 	if (data_in_urb) {
 		usb_kill_urb(data_in_urb);
 		usb_put_urb(data_in_urb);
@@ -801,6 +956,15 @@ static int uas_eh_device_reset_handler(struct scsi_cmnd *cmnd)
 		return FAILED;
 	}
 
+	/*
+	 * 设备 reset 成功（usb_reset_device 返回 0），发射 RESET 事件
+	 *
+	 * 为什么在此打点：
+	 *   - reset 是设备稳定性指标的关键事件，LcIod 侧据此统计设备
+	 *     reset 次数，仅上报成功的 reset（失败路径已提前 return FAILED）
+	 *   - srb 传 NULL：reset 与具体命令无绑定关系
