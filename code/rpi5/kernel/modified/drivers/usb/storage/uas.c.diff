@@ -1201,6 +1377,18 @@ static void uas_disconnect(struct usb_interface *intf)
 	struct uas_dev_info *devinfo = (struct uas_dev_info *)shost->hostdata;
 	unsigned long flags;
 
+	/*
+	 * 设备断开，在 teardown（置 resetting/杀 URB）之前广播 DISCONNECT
+	 *
+	 * 为什么在此打点：
+	 *   - 必须先于任何资源销毁通知厂商模块，否则监控驱动无法拿到
+	 *     完整的 devinfo 现场（URB/shost 尚存活）
+	 *   - 与 probe 的 DEVICE_PROBE 成对，厂商链为 blocking 链，
+	 *     disconnect 为进程上下文，可安全回调
+	 */
+	dev_info(&devinfo->intf->dev, "uas: notifying vendor modules (DISCONNECT)\n");
+	blocking_notifier_call_chain(&uas_vendor_nh, USB_STOR_NOTIFIER_DEVICE_DISCONNECT, devinfo);
+
 	spin_lock_irqsave(&devinfo->lock, flags);
 	devinfo->resetting = 1;
 	spin_unlock_irqrestore(&devinfo->lock, flags);
