 }
@@ -1041,6 +1205,18 @@ static int uas_probe(struct usb_interface *intf, const struct usb_device_id *id)
 	if (result)
 		goto free_streams;
 
+	/*
+	 * 初始化 per-device 原子通知链，并向厂商模块广播 DEVICE_PROBE
+	 *
+	 * 为什么在此打点：
