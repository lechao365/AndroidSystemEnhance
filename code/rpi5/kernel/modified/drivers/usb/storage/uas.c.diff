+/* 厂商级生命周期通知链（blocking）：接收 DEVICE_PROBE / DEVICE_DISCONNECT */
+static BLOCKING_NOTIFIER_HEAD(uas_vendor_nh);
+
+void uas_notifier_init(struct uas_dev_info *devinfo)
+{
+	ATOMIC_INIT_NOTIFIER_HEAD(&devinfo->notifier);
+}
+EXPORT_SYMBOL_GPL(uas_notifier_init);
+
+int uas_notifier_call(struct uas_dev_info *devinfo, unsigned long event, void *data)
+{
+	return atomic_notifier_call_chain(&devinfo->notifier, event, data);
+}
+EXPORT_SYMBOL_GPL(uas_notifier_call);
+
+int uas_notifier_register(struct uas_dev_info *devinfo, struct notifier_block *nb)
+{
+	int rc = atomic_notifier_chain_register(&devinfo->notifier, nb);
+
+	if (rc)
+		dev_err(&devinfo->intf->dev,
+			"uas: per-device notifier register failed rc=%d\n", rc);
+	return rc;
+}
+EXPORT_SYMBOL_GPL(uas_notifier_register);
+
+int uas_notifier_unregister(struct uas_dev_info *devinfo, struct notifier_block *nb)
+{
+	int rc = atomic_notifier_chain_unregister(&devinfo->notifier, nb);
+
+	if (rc)
+		dev_err(&devinfo->intf->dev,
+			"uas: per-device notifier unregister failed rc=%d\n", rc);
+	return rc;
+}
+EXPORT_SYMBOL_GPL(uas_notifier_unregister);
+
+int uas_register_vendor_notifier(struct notifier_block *nb)
+{
+	int rc = blocking_notifier_chain_register(&uas_vendor_nh, nb);
+
+	if (rc)
+		pr_err("uas: vendor notifier register failed rc=%d\n", rc);
+	return rc;
+}
+EXPORT_SYMBOL_GPL(uas_register_vendor_notifier);
+
+int uas_unregister_vendor_notifier(struct notifier_block *nb)
+{
+	int rc = blocking_notifier_chain_unregister(&uas_vendor_nh, nb);
+
+	if (rc)
+		pr_err("uas: vendor notifier unregister failed rc=%d\n", rc);
+	return rc;
+}
+EXPORT_SYMBOL_GPL(uas_unregister_vendor_notifier);
+
+/*
+ * uas_emit — 填充 uas_notifier_data 载荷并向 per-device 原子链发射事件
+ *
+ * 为什么提供此辅助：
+ *   - 九个打点位置统一收口，避免重复拼装载荷的样板代码
+ *   - srb 可空（如 RESET 事件无关联命令）；result/status 为调用方语义
+ *   - data_direction 直接用字面量 1/2/0（与 vendor_lechao_usbd-ioctl.h 的
+ *     VENDOR_LECHAO_USBD_DIR_READ/WRITE 同值），避免 uas.c 反向依赖 vendor
+ *     头文件造成跨层耦合
+ *   - duration_ns 由 LcIod 侧以 START/END 事件时间戳差值计算，内核侧不填
+ */
+static void uas_emit(struct uas_dev_info *devinfo, unsigned long event,
+		     struct scsi_cmnd *cmnd, int result, int status)
+{
+	struct uas_notifier_data nd;
+
+	memset(&nd, 0, sizeof(nd));
+	nd.devinfo = devinfo;
+	nd.srb = cmnd;
+	nd.result = result;
+	nd.status = status;
+	nd.data_direction = cmnd ?
+		(cmnd->sc_data_direction == DMA_FROM_DEVICE ? 1 :
+		 (cmnd->sc_data_direction == DMA_TO_DEVICE ? 2 : 0)) : 0;
+	nd.data_len = cmnd ? scsi_bufflen(cmnd) : 0;
+
+	uas_notifier_call(devinfo, event, &nd);
+}
+
 static void uas_do_work(struct work_struct *work)
 {
 	struct uas_dev_info *devinfo =
@@ -136,6 +225,18 @@ static void uas_scan_work(struct work_struct *work)
 
 	dev_dbg(&devinfo->intf->dev, "starting scan\n");
 	scsi_scan_host(shost);
+	/*
+	 * 扫描完成后补发 DEVICE_PROBE 厂商事件
+	 *
+	 * 为什么在此打点：
+	 *   - uas_probe 的 PROBE 通知在设备插入时立即发射，若 LcIod 此时
+	 *     尚未加载，会漏掉该设备的存量事件
+	 *   - scsi_scan_host 完成（已存在设备全部入队）后补发一次，覆盖
+	 *     LcIod 晚加载时已存在设备的存量补发场景，保证监控驱动最终
+	 *     能感知所有在线设备
+	 */
+	dev_info(&devinfo->intf->dev, "uas: notifying vendor modules (PROBE rescan)\n");
+	blocking_notifier_call_chain(&uas_vendor_nh, USB_STOR_NOTIFIER_DEVICE_PROBE, devinfo);
 	dev_dbg(&devinfo->intf->dev, "scan complete\n");
 }
 
@@ -167,6 +268,12 @@ static void uas_zap_pending(struct uas_dev_info *devinfo, int result)
 		/* Sense urbs were killed, clear COMMAND_INFLIGHT manually */
 		cmdinfo->state &= ~COMMAND_INFLIGHT;
 		cmnd->result = result << 16;
+		/*
+		 * 命令被 reset/disconnect 清空，未走正常状态机 END 路径，
+		 * 此处补发 TRANSPORT_END（result 为入参 result<<16 的原始 int），
+		 * 确保监控驱动对每条 pending 命令都能收到收尾事件
+		 */
+		uas_emit(devinfo, USB_STOR_NOTIFIER_TRANSPORT_END, cmnd, result, 0);
 		err = uas_try_complete(cmnd, __func__);
 		WARN_ON(err != 0);
 	}
@@ -254,6 +361,18 @@ static int uas_try_complete(struct scsi_cmnd *cmnd, const char *caller)
 		return -EBUSY;
 	devinfo->cmnd[cmdinfo->uas_tag - 1] = NULL;
 	uas_free_unsubmitted_urbs(cmnd);
+	/*
+	 * 传输完成（成功或失败），在 scsi_done 之前发射 TRANSPORT_END
+	 *
+	 * 为什么在此打点：
+	 *   - uas_try_complete 是所有命令收尾的统一汇聚点，此处置为
+	 *     COMMAND_INFLIGHT 等标志已清、URB 已释放，但 SCSI 上层尚未
+	 *     感知完成，适合携带最终 result/status 通知监控驱动
+	 *   - 持 devinfo->lock（自旋锁）上下文调用，atomic notifier 链
+	 *     的回调不可睡眠，满足原子链约束
+	 */
+	uas_emit(devinfo, USB_STOR_NOTIFIER_TRANSPORT_END, cmnd,
+		 cmnd->result >> 16, cmnd->result & 0xff);
 	scsi_done(cmnd);
 	return 0;
 }
@@ -316,6 +435,16 @@ static void uas_stat_cmplt(struct urb *urb)
 	if (status) {
 		if (status != -ENOENT && status != -ECONNRESET && status != -ESHUTDOWN)
 			dev_err(&urb->dev->dev, "stat urb: status %d\n", status);
+		/*
+		 * 状态 URB 上报错误（无法从 IU 解析出关联命令，srb 传 NULL）
+		 *
+		 * 为什么在此打点：
+		 *   - 状态传输失败意味着该命令的收尾信息不可信，属于传输层
+		 *     异常，需通知监控驱动记录错误
+		 *   - status 同时作为 result/status 上抛，便于 LcIod 区分
+		 *     普通错误码与设备移除类错误（-ENOENT 等）
+		 */
+		uas_emit(devinfo, USB_STOR_NOTIFIER_TRANSPORT_ERROR, NULL, status, status);
 		goto out;
 	}
 
@@ -423,6 +552,11 @@ static void uas_data_cmplt(struct urb *urb)
 		/* error: no data transfered */
 		scsi_set_resid(cmnd, sdb->length);
 		set_host_byte(cmnd, DID_ERROR);
+		/*
+		 * 数据 URB 传输失败（-EOVERFLOW/-EPIPE 等），本次传输无有效
