@@ -711,6 +845,17 @@ static int uas_queuecommand_lck(struct scsi_cmnd *cmnd)
 	}
 
 	devinfo->cmnd[idx] = cmnd;
+	/*
+	 * 命令成功入队并提交到 uas_tag 槽位，发射 TRANSPORT_START
+	 *
+	 * 为什么在此打点：
+	 *   - 此点代表 SCSI 命令已进入 UAS 传输生命周期（tag 已分配、
+	 *     URB 已成功提交），是 START 事件的准确起点
+	 *   - 持 devinfo->lock（自旋锁）上下文调用，atomic notifier 链
+	 *     回调不可睡眠，满足原子链约束
+	 *   - result/status 传 0：START 语义不含错误码
