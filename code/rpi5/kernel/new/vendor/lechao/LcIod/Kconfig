config VENDOR_LECHAO_USBD
	bool "Lechao USB Storage Rate Monitor"
	depends on VENDOR_LECHAO
	depends on USB_STORAGE=y
	depends on USB_UAS=y
	select LCVIEW
	default y
	help
	  Monitor transfer rates for USB mass-storage devices.
	  Provides per-device statistics via character devices named
	  /dev/vendor_lechao_usbdN (N = 0..15).

config VENDOR_LECHAO_SD_MON
	bool "Lechao SD/MMC block-layer health monitor"
	depends on VENDOR_LECHAO
	depends on LCVIEW
	depends on MMC_BLOCK=y
	default y
	help
	  Monitor SD/MMC block-layer health: aggregate transfer
	  bytes/requests over a 10s window and, on card-busy stuck,
	  progressively strip SD bus-speed caps to downgrade the card.
	  Events are reported via LcView; enable knob and counters are
	  exposed under /sys/class/lciod_sd/lciod_sd.
