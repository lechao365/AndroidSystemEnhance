# rpi5 WiFi 自动连接服务（oneshot 模式）
#
# 依赖链（任意环节断裂均会导致 WiFi 不可用）:
#   1. sys.boot_completed=1 触发 → start rpi5_wifi_connect
#   2. 脚本读取 /boot/wifi.conf（mmcblk0p1 vfat，需 SELinux permissive 或 allow 规则）
#   3. 等待 WifiService 就绪（cmd wifi）→ set-wifi-enabled + connect-network
#   4. 脚本进入 daemon 循环（断线重连）
#
# 关键前提:
#   - androidboot.selinux=permissive 为必须（见 BoardConfig.mk cmdline）
#   - seclabel u:r:rpi5_wifi_connect:s0 将服务运行在独立的 WiFi 连接域
#   - oneshot + disabled: 仅由 boot_completed 触发一次，不自动重启
#
# 脚本: /system/bin/rpi5_wifi_connect (Android.bp sh_binary)
# 配置: /boot/wifi.conf (mkbootimg.mk 拷贝到 mmcblk0p1 FAT32)
#
service rpi5_wifi_connect /system/bin/rpi5_wifi_connect
    class late_start
    user root
    group root
    seclabel u:r:rpi5_wifi_connect:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start rpi5_wifi_connect
