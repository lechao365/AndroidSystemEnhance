# lechao_lcview —— 乐超自定义显示的系统服务守护进程
#   vendor 端守护进程（/vendor/bin），直读内核设备节点采集并落盘事件日志
#   架构演进（HAL 退役后）：daemon 直读内核设备节点 /dev/vendor_lechao_lcview
#   （原经 vndbinder 调 lcview_hal 的链路已取消，HAL 相关 binder/service
#   规则随 HAL 退役一并移除）

# 声明 lechao_lcview 为 SELinux domain
type lechao_lcview, domain;
# 声明 lcview 可执行文件的标签（file_contexts 匹配 /vendor/bin/lechao_lcview）
type lechao_lcview_exec, exec_type, vendor_file_type, file_type;
# 声明 lcview 数据文件的类型 —— 用于存储运行时产生的显示配置、状态等数据
#   data_file_type 表示这是一类数据文件，确保存放在 /data/vendor/ 下
type lechao_lcview_data_file, file_type, data_file_type;
# 内核设备节点类型（原定义于 lechao_lcview_hal.te，HAL 退役后并入本域；
# file_contexts 匹配 /dev/vendor_lechao_lcview，daemon 直读使用；
# 2026-09-01 去 hal 残留：类型名 lechao_lcview_hal_device → lechao_lcview_device）
type lechao_lcview_device, dev_type, file_type;

# init 启动守护进程 —— init 执行 lchao_lcview_exec → domain transition
init_daemon_domain(lechao_lcview)

# 允许 lcview 在 /data/vendor/lechao_lcview/ 下创建目录
#   create_dir_perms 包含 create_dir_perms = { create setattr link unlink ioctl read write
#     getattr add_name remove_name reparent search rmdir open } 等目录操作权限
#   为什么：lcview 需要在 /data/vendor/ 下创建持久化工作目录用于存储配置和日志
allow lechao_lcview lechao_lcview_data_file:dir { create_dir_perms };
# 允许 lcview 在该目录下创建文件（如运行时生成的显示参数配置文件）
#   create_file_perms 包含普通文件创建和读写所需的所有权限
allow lechao_lcview lechao_lcview_data_file:file { create_file_perms };

# 允许读取 /vendor/etc/lcview_events.json schema 配置文件
# daemon 启动时加载 schema，热重载时重新读取
allow lechao_lcview vendor_file:dir search;
allow lechao_lcview vendor_file:file r_file_perms;

# 允许 daemon 向 logd 写日志（ALOGI/ALOGE 走 /dev/socket/logd 的 unix_dgram_socket）
# system 域默认不继承 logd 写权限，缺失时全部日志被 avc denied 静默丢弃，
# HAL 断连/schema 失败/写盘失败均无日志现场（对照 hal.te 同款规则）
allow lechao_lcview logd:unix_dgram_socket write;

# 允许 daemon 直读内核设备节点 /dev/vendor_lechao_lcview（HAL 停用后）
#   ioctl 是核心：read/ioctl 取环形缓冲批量记录（LCVIEW_GET/READ_RING），
#   open/read/write/getattr 为基础设备操作（对照 hal.te 同款规则）
allow lechao_lcview lechao_lcview_device:chr_file { open read write ioctl getattr };
# 允许 daemon 搜索 /dev 目录 —— 打开 /dev/vendor_lechao_lcview 之前需要遍历 /dev
allow lechao_lcview device:dir { search read };
