// ============================================================
// hal/Android.bp — lechao_lcview HAL 层编译配置
// 所属模块：LcView 事件日志系统 — HAL 层
// 设计目的：编译两个模块：
//   1) lechao_lcview_hal — 用户态 HAL 守护进程二进制
//   2) vendor.lechao.lcview.ILcView-vintf — VINTF manifest 声明
//
// HAL 层负责直接与内核驱动交互（通过 epoll + ioctl + read），
// 并通过 NDK Binder 提供 ILcView AIDL 接口供 daemon 调用。
// vendor: true 表示安装到 vendor 分区（vendor HAL 标准做法）。
//
// 为什么 libjsoncpp 不在 HAL 的依赖中：
//   HAL 层不解析 JSON schema，只负责从内核读取原始二进制数据，
//   JSON 解析是 daemon 层的职责。
// ============================================================

cc_binary {
    name: "lechao_lcview_hal",
    vendor: true,
    cflags: ["-Wall", "-Werror"],
    header_libs: ["vendor.lechao.lcview_headers", "vendor_lechao_log_headers"],
    init_rc: ["lechao_lcview_hal.rc"],
    srcs: [
        // main 文件单独列出（不进 filegroup）：filegroup 同时被
        // tests/cc_test 复用，含 main() 会与 gtest 主函数链接冲突
        ":lechao_lcview_hal_sources",
        "main_lcview_hal.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.lechao.lcview-V2-ndk",
    ],
}

// filegroup lechao_lcview_hal_sources — 供 tests/Android.bp 的 cc_test 复用 HAL 源码
// （不含 main_lcview_hal.cpp，避免与 gtest 主函数冲突）
filegroup {
    name: "lechao_lcview_hal_sources",
    srcs: [
        "LcView.cpp",
        "DeviceReader.cpp",
    ],
}

// VINTF manifest 声明文件：
// 将 vendor.lechao.lcview.ILcView-service.xml 预置到
// /vendor/etc/vintf/manifest/ 目录下。
// 该文件声明了 vendor.lechao.lcview AIDL HAL 的存在，
// 使 Android 框架能通过 VINTF 接口查询机制发现此 HAL 服务。
// VINTF 声明是 Android Treble 架构的要求，用于 vendor/system 分离。
prebuilt_etc {
    name: "vendor.lechao.lcview.ILcView-vintf",
    owner: "lechao",
    vendor: true,
    src: "vendor.lechao.lcview.ILcView-service.xml",
    filename: "vendor.lechao.lcview.ILcView-service.xml",
    sub_dir: "vintf/manifest",
    installable: true,
}
