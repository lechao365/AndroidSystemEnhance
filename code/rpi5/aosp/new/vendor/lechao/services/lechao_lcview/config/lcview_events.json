{
  "version": 1,
  "events": [
    {
      "id": 1,
      "name": "usb_connect",
      "desc": "reserved: USB connect event (预留占位，字段未定义)",
      "fields": []
    },
    {
      "id": 2,
      "name": "gpio_irq",
      "desc": "reserved: GPIO IRQ event (预留占位，字段未定义)",
      "fields": []
    },
    {
      "id": 3,
      "name": "sensor_data",
      "desc": "reserved: sensor data event (预留占位，字段未定义)",
      "fields": []
    },
    {
      "id": 5,
      "name": "usb_transport_end",
      "desc": "USB bulk transport completes",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "data_direction",  "type": "int64"},
        {"name": "bytes_xferred",   "type": "int64"},
        {"name": "elapsed_ns",      "type": "int64"},
        {"name": "was_error",       "type": "int64"}
      ]
    },
    {
      "id": 6,
      "name": "usb_transport_error",
      "desc": "USB bulk transport error",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "data_direction",  "type": "int64"},
        {"name": "result",          "type": "int64"}
      ]
    },
    {
      "id": 7,
      "name": "usb_reset",
      "desc": "USB device reset",
      "fields": [
        {"name": "device_index",    "type": "int64"}
      ]
    },
    {
      "id": 8,
      "name": "usb_probe",
      "desc": "USB device probed",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "vid",             "type": "int64", "sensitive": true},
        {"name": "pid",             "type": "int64", "sensitive": true},
        {"name": "vendor",          "type": "string", "sensitive": true},
        {"name": "product",         "type": "string", "sensitive": true}
      ]
    },
    {
      "id": 9,
      "name": "usb_disconnect",
      "desc": "USB device disconnected",
      "fields": [
        {"name": "device_index",    "type": "int64"}
      ]
    },
    {
      "id": 10,
      "name": "usb_stall",
      "desc": "USB endpoint stall",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "status",          "type": "int64"}
      ]
    },
    {
      "id": 11,
      "name": "usb_timeout",
      "desc": "USB transfer timeout",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "status",          "type": "int64"}
      ]
    },
    {
      "id": 12,
      "name": "usb_data_corrupt",
      "desc": "USB data corruption detected",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "status",          "type": "int64"}
      ]
    },
    {
      "id": 13,
      "name": "usb_rate_degraded",
      "desc": "USB rate degraded",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "latency_ns",      "type": "int64"}
      ]
    },
    {
      "id": 14,
      "name": "slow_disk",
      "desc": "block write latency sustained above threshold (daemon rule-2)",
      "fields": [
        {"name": "device",                "type": "string"},
        {"name": "write_avg_latency_ms",  "type": "int64"},
        {"name": "threshold_ms",          "type": "int64"},
        {"name": "consecutive",           "type": "int32"}
      ]
    },
    {
      "id": 15,
      "name": "sd_health",
      "desc": "SD/MMC 10s window health aggregate (kernel lciod_sd)",
      "fields": [
        {"name": "window_bytes",     "type": "int64"},
        {"name": "window_requests",  "type": "int64"},
        {"name": "window_ms",        "type": "int64"},
        {"name": "total_bytes",      "type": "int64"},
        {"name": "total_requests",   "type": "int64"},
        {"name": "stuck_count",      "type": "int64"},
        {"name": "ssr_speed_class",  "type": "int64"},
        {"name": "ssr_uhs_grade",    "type": "int64"}
      ]
    },
    {
      "id": 16,
      "name": "sd_stuck",
      "desc": "SD/MMC card-busy stuck with progressive speed downgrade",
      "fields": [
        {"name": "old_speed",        "type": "int64"},
        {"name": "new_speed",        "type": "int64"},
        {"name": "err",              "type": "int64"},
        {"name": "stuck_count",      "type": "int64"}
      ]
    },
    {
      "id": 17,
      "name": "usb_latency_tail",
      "desc": "USB transfer latency long-tail bucket count exceeded threshold (daemon rule)",
      "fields": [
        {"name": "device_index",  "type": "int64"},
        {"name": "direction",     "type": "int64"},
        {"name": "latency_ms",    "type": "int64"},
        {"name": "count",         "type": "int64"},
        {"name": "threshold",     "type": "int64"}
      ]
    },
    {
      "id": 18,
      "name": "qos_auto_adjust",
      "desc": "SD window latency long-tail detected, feedback source for daemon auto QoS tier (kernel lciod_sd)",
      "fields": [
        {"name": "avg_lat_us",    "type": "int64"},
        {"name": "tail_count",    "type": "int64"},
        {"name": "threshold_us",  "type": "int64"}
      ]
    },
    {
      "id": 19,
      "name": "zram_swap_pressure",
      "desc": "zram swap-in pressure window exceeded threshold (daemon synthetic report, no kernel emitter)",
      "fields": [
        {"name": "swapin_pages",    "type": "int64"},
        {"name": "swapout_pages",   "type": "int64"},
        {"name": "zram_read_bytes", "type": "int64"},
        {"name": "zram_write_bytes", "type": "int64"},
        {"name": "psi_io_total_us", "type": "int64"},
        {"name": "threshold_pages", "type": "int64"}
      ]
    },
    {
      "id": 20,
      "name": "trim",
      "desc": "ext4 segmented FITRIM executed by lciod TrimManager (daemon synthetic report, no kernel emitter)",
      "fields": [
        {"name": "trimmed_bytes",         "type": "int64"},
        {"name": "segments",              "type": "int64"},
        {"name": "duration_ms",           "type": "int64"},
        {"name": "free_ratio_bp",         "type": "int64"},
        {"name": "discard_ios_delta",     "type": "int64"},
        {"name": "discard_sectors_delta", "type": "int64"},
        {"name": "time_queue_delta_ms",   "type": "int64"}
      ]
    },
    {
      "id": 21,
      "name": "writeback_guard",
      "desc": "zram writeback backing device lost/recovered detected by lciod WritebackGuard (daemon synthetic report, no kernel emitter, no auto rebind)",
      "fields": [
        {"name": "lost",           "type": "int64"},
        {"name": "target_present", "type": "int64"},
        {"name": "backing_dev",    "type": "string"}
      ]
    }
  ]
}
