{
  "version": 1,
  "events": [
    {
      "id": 1,
      "name": "usb_connect",
      "desc": "reserved: USB connect event (预留占位，字段未定义)",
      "fields": []
    },
    {
      "id": 2,
      "name": "gpio_irq",
      "desc": "reserved: GPIO IRQ event (预留占位，字段未定义)",
      "fields": []
    },
    {
      "id": 3,
      "name": "sensor_data",
      "desc": "reserved: sensor data event (预留占位，字段未定义)",
      "fields": []
    },
    {
      "id": 5,
      "name": "usb_transport_end",
      "desc": "USB bulk transport completes",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "data_direction",  "type": "int64"},
        {"name": "bytes_xferred",   "type": "int64"},
        {"name": "elapsed_ns",      "type": "int64"},
        {"name": "was_error",       "type": "int64"}
      ]
    },
    {
      "id": 6,
      "name": "usb_transport_error",
      "desc": "USB bulk transport error",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "data_direction",  "type": "int64"},
        {"name": "result",          "type": "int64"}
      ]
    },
    {
      "id": 7,
      "name": "usb_reset",
      "desc": "USB device reset",
      "fields": [
        {"name": "device_index",    "type": "int64"}
      ]
    },
    {
      "id": 8,
      "name": "usb_probe",
      "desc": "USB device probed",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "vid",             "type": "int64", "sensitive": true},
        {"name": "pid",             "type": "int64", "sensitive": true},
        {"name": "vendor",          "type": "string", "sensitive": true},
        {"name": "product",         "type": "string", "sensitive": true}
      ]
    },
    {
      "id": 9,
      "name": "usb_disconnect",
      "desc": "USB device disconnected",
      "fields": [
        {"name": "device_index",    "type": "int64"}
      ]
    },
    {
      "id": 10,
      "name": "usb_stall",
      "desc": "USB endpoint stall",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "status",          "type": "int64"}
      ]
    },
    {
      "id": 11,
      "name": "usb_timeout",
      "desc": "USB transfer timeout",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "status",          "type": "int64"}
      ]
    },
    {
      "id": 12,
      "name": "usb_data_corrupt",
      "desc": "USB data corruption detected",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "status",          "type": "int64"}
      ]
    },
    {
      "id": 13,
      "name": "usb_rate_degraded",
      "desc": "USB rate degraded",
      "fields": [
        {"name": "device_index",    "type": "int64"},
        {"name": "latency_ns",      "type": "int64"}
      ]
    },
    {
      "id": 14,
      "name": "slow_disk",
      "desc": "block write latency sustained above threshold (daemon rule-2)",
      "fields": [
        {"name": "device",                "type": "string"},
        {"name": "write_avg_latency_ms",  "type": "int64"},
        {"name": "threshold_ms",          "type": "int64"},
        {"name": "consecutive",           "type": "int32"}
      ]
    },
    {
      "id": 15,
      "name": "sd_health",
      "desc": "SD/MMC 10s window health aggregate (kernel lciod_sd)",
      "fields": [
        {"name": "window_bytes",     "type": "int64"},
        {"name": "window_requests",  "type": "int64"},
        {"name": "window_ms",        "type": "int64"},
        {"name": "total_bytes",      "type": "int64"},
        {"name": "total_requests",   "type": "int64"},
        {"name": "stuck_count",      "type": "int64"}
      ]
    },
    {
      "id": 16,
      "name": "sd_stuck",
      "desc": "SD/MMC card-busy stuck with progressive speed downgrade",
      "fields": [
        {"name": "old_speed",        "type": "int64"},
        {"name": "new_speed",        "type": "int64"},
        {"name": "err",              "type": "int64"},
        {"name": "stuck_count",      "type": "int64"}
      ]
    }
  ]
}
