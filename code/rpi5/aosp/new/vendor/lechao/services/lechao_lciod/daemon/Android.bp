// ============================================================
// daemon/Android.bp — System Daemon 编译规则
// 所属模块: lechao_lciod (system 分区二进制)
// 设计目的: 编译 System Daemon 进程。该进程运行在 system 分区，
//           作为 IO 监控服务的控制面，负责:
//           1. 注册 IIoService AIDL 接口供上层调用
//           2. 通过 HAL 客户端连接 Vendor HAL 获取数据
//           3. 后台线程周期性监控 IO 速率和事件
// 依赖: system.lechao.lciod-ndk — system 侧 AIDL 桩代码
//       vendor.lechao.lciod-V1-ndk — vendor 侧 AIDL 桩代码
// ============================================================
// filegroup: daemon 生产源码（不含 main，供 lechao_lciod_unit_test 编入测试；
// 与 lcview lechao_lcview_daemon_sources 模式对齐）
filegroup {
    name: "lechao_lciod_daemon_sources",
    srcs: [
        "service.cpp",
        "hal_client.cpp",
        "link_monitor.cpp",   // R2 方向 5+6：全局链路事件监控（LinkMonitor）
        "io_qos.cpp",         // R4 方向 1/2/3/5：SD 卡写 QoS 限速（IoQosManager）
    ],
}

cc_binary {
    name: "lechao_lciod",
    owner: "lechao",
    srcs: [
        "main_lciod.cpp",               // 进程入口（独立文件，避免与 gtest main 冲突）
        ":lechao_lciod_daemon_sources",
    ],
    shared_libs: [
        "libbase",               // Android 基础库（LOG/strings等）
        "libbinder_ndk",         // NDK Binder 框架库
        "liblog",                // logcat 日志输出
        "system.lechao.lciod-ndk",  // system AIDL 接口 NDK 生成代码
        "vendor.lechao.lciod-V1-ndk", // vendor AIDL 接口 NDK 生成代码
    ],
    static_libs: [
        "lechao_lciod_common",   // 公共解析工具（minor_utils）
    ],
    header_libs: [
        "vendor_lechao_log_headers",
    ],
    include_dirs: [
        // R-14 方向 1：共享事件枚举头（vendor_lechao_usbd-ioctl.h）位于 hal/
        "vendor/lechao/services/lechao_lciod/hal",
    ],
    init_rc: ["lechao_lciod.rc"],  // init 启动配置文件
}


