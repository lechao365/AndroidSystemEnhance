# ============================================================
# lechao_lciod.rc — System Daemon init 启动配置文件
# 所属模块: lechao_lciod daemon
# 设计目的: 定义 IO 监控服务的 system 分区进程的启动参数。
#           采用延时启动策略（等待 boot_completed），避免在
#           系统启动初期与 Vendor HAL 竞争资源。
# 架构角色: init → lechao_lciod (/system/bin) → (AIDL) → HAL
# ============================================================

# lechao_lciod: 系统 IO Daemon 服务
# 路径: /system/bin/lechao_lciod
# 启动条件: sys.boot_completed=1（系统启动完成后触发）
# 用户/组: system（系统级服务，可访问 AIDL service_manager）
# 接口声明: 注册为 system.lechao.lciod.IIoService/default
# LCD-005：非 oneshot——进程异常退出（crash/OOM）后 init 自动重启，
#   服务从 servicemanager 消失的时间窗收敛到秒级（oneshot 下须等
#   下次 reboot，上层全部拿到 null binder）
service lechao_lciod /system/bin/lechao_lciod
    class main
    user system
    group system
    interface aidl system.lechao.lciod.IIoService/default

# 系统启动完成时启动 IO Daemon
# 延迟启动的原因：
#   1. Vendor HAL 可能还在启动阶段
#   2. 内核驱动设备节点可能还未创建完成
on property:sys.boot_completed=1
    start lechao_lciod

# R4 方向 4：预建 cgroup v1 blkio QoS 组并授权 system 用户
# daemon 以 system 用户运行，无法在 root 拥有的 cgroup 挂载点（真机 v1
# blkio 挂载于 /dev/blkio，目录 0555）下建组/写限速文件；由 init 预建
# lechao_bg 组目录并将限速/迁移控制文件 owner 移交 system，配合 sepolicy
# cgroup 类型授权使 daemon 可写 blkio.throttle.* 与 tasks（IoQosManager
# EnsureGroup 对已存在组幂等成功，不重复建）。
on post-fs-data
    mkdir /dev/blkio/lechao_bg 0770 system system
    chown system system /dev/blkio/lechao_bg/tasks
    chown system system /dev/blkio/lechao_bg/cgroup.procs
    chown system system /dev/blkio/lechao_bg/blkio.throttle.read_bps_device
    chown system system /dev/blkio/lechao_bg/blkio.throttle.write_bps_device
