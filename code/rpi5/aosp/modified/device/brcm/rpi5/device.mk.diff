     frameworks/native/data/etc/android.hardware.usb.host.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.usb.host.xml \
     frameworks/native/data/etc/android.software.midi.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.software.midi.xml
 
+# Vendor Lechao SELinux -- added after module builds
+
 # Virtualization
 $(call inherit-product, packages/modules/Virtualization/apex/product_packages.mk)
 
@@ -207,3 +244,16 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.wifi.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.wifi.xml
+
+# Headless mode
+# =============
+# debug.sf.no_hwc=1 告知 SurfaceFlinger 使用软件合成而非依赖硬件 HWC。
+# 当 RPi5 无 HDMI 显示器时，HWC (hwc3-service.drm) 通过 null-display 运行，
+# 但 GraphicBufferMapper 初始化可能 abort（无 /dev/dri/renderD128）。
+# 此属性让 SF 绕过 HWC 直接使用软件渲染，避免级联崩溃导致 boot 失败。
+#
+# 注意：必须用 PRODUCT_PROPERTY_OVERRIDES（不是 vendor.prop），否则属性
+# 会被前缀为 ro.vendor. 导致 SF 读不到 debug.sf.no_hwc。
+#
+# 改动影响：仅修改此属性，需编译 boot.img 或 system.img 使属性生效。
+PRODUCT_PROPERTY_OVERRIDES += debug.sf.no_hwc=1
