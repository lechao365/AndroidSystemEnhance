diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 9692b33..503c891 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -28,3 +28,41 @@
 /dev/block/sda5       u:object_r:system_block_device:s0
 /dev/block/sda6       u:object_r:system_block_device:s0
 /dev/block/sda7       u:object_r:metadata_block_device:s0
+
+# ===== lechao_lciod - IO 控制器 HAL 层（vendor 分区） =====
+#  HAL 可执行文件：位于 /vendor/bin，标签 lechao_lciod_hal_exec
+#  在 lechao_lciod_hal.te 中定义：type lechao_lciod_hal_exec, exec_type, vendor_file_type, file_type;
+#  为什么 /vendor/bin：HAL 实现必须放在 vendor 分区，这是 Android Treble 架构要求
+/vendor/bin/lechao_lciod_hal                   u:object_r:lechao_lciod_hal_exec:s0
+#  HAL 对应的内核设备节点：通配符 [0-9]+ 支持多实例（usbd0、usbd1）
+#  标签 lechao_lciod_hal_device 使 lechao_lciod_hal domain 可以 open/read/write/ioctl
+/dev/vendor_lechao_usbd[0-9]+                u:object_r:lechao_lciod_hal_device:s0
+
+# ===== lechao_lciod - IO 控制器系统服务（system 分区） =====
+#   system 端守护进程 /system/bin/lechao_lciod
+#   标签 lechao_lciod_exec，对应 lechao_lciod domain
+#   注意 lciod_hal 在 vendor 分区，lciod 在 system 分区 —— 跨 partition 通信必须通过 vndbinder
+/system/bin/lechao_lciod                       u:object_r:lechao_lciod_exec:s0
+
+# ===== lechao_lcview - 自定义显示系统（vendor 分区） =====
+#  daemon 直读内核后 HAL 退役：/vendor/bin/lechao_lcview_hal 的
+#  lechao_lcview_hal_exec 条目已删（二进制退役）
+#  显示设备节点 /dev/vendor_lechao_lcview（单实例，固定名称）
+#  标签 lechao_lcview_device（类型定义已并入 lechao_lcview.te），
+#  daemon 直读该节点，保留标签
+/dev/vendor_lechao_lcview                    u:object_r:lechao_lcview_device:s0
+
+# ===== rpi5_wifi_connect - 开机自动连接 WiFi 脚本（system 分区） =====
+#  shell 脚本 /system/bin/rpi5_wifi_connect
+#  标签 rpi5_wifi_connect_exec（te 中声明的 exec_type，init_daemon_domain 处理 domain transition）
+#  init.rpi5.wifi.rc 中 seclabel 为 u:r:rpi5_wifi_connect:s0，以独立域运行
+/system/bin/rpi5_wifi_connect                    u:object_r:rpi5_wifi_connect_exec:s0
+
+# ===== lechao_lcview - 自定义显示系统服务（vendor 分区） =====
+#  vendor 端守护进程 /vendor/bin/lechao_lcview
+/vendor/bin/lechao_lcview                    u:object_r:lechao_lcview_exec:s0
+#  lcview 的数据文件目录 /data/vendor/lechao_lcview/
+#  (/.*)? 表示递归匹配目录下的所有文件
+#  标签 lechao_lcview_data_file → lcview 域可以在此目录下创建/读写文件
+#  为什么 /data/vendor：vendor 分区的持久化数据必须放在 /data/vendor 下
+/data/vendor/lechao_lcview(/.*)?                    u:object_r:lechao_lcview_data_file:s0
