# opencode 工具链依赖（从 .opencode/.gitignore 迁移）
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock


# 工程产物目录（本地产物，不归档）
engineering/output/*
!engineering/output/README.md

# 根级 output 防御（工程产物统一在 engineering/output/）
/output/

# Python 缓存（本地产物）
__pycache__/
*.pyc
.pytest_cache/
