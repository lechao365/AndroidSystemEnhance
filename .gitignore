# opencode 工具链依赖（从 .opencode/.gitignore 迁移）
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock


# harness 脚本维测日志（本地产物，不归档）
engineering/harness/log/*
!engineering/harness/log/.gitkeep

# loop engineering 本地产物（编译缓存、Host 日志、pytest 缓存）
__pycache__/
*.pyc
engineering/loop/**/.host-log/
.pytest_cache/

# loop engineering 运行产物（本地产物，不归档）
engineering/loop/runs/*
!engineering/loop/runs/.gitkeep
