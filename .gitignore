# opencode 工具链依赖（从 .opencode/.gitignore 迁移）
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock


# 根级 output 防御
/output/

# CI 运行时产物（不入库）
/data/ci/

# harness 运行时产物（plan/verify/构建报告等，不入库）
/harness/log/

# 收据趋势锁文件（ws_report 并发写锁残留，误入库过，20260912 起忽略）
/data/verify-results/trend.md.lock

# Python 缓存（本地产物）
__pycache__/
*.pyc
.pytest_cache/

# promote 审批凭据（评审人独立持有，不入库）
/harness/config/promote-approval.env
