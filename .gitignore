# opencode 工具链依赖（从 .opencode/.gitignore 迁移）
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock


# 工程产物目录（本地产物，不归档）
engineering/output/log/*
!engineering/output/log/.gitkeep

engineering/output/host-log/*
!engineering/output/host-log/.gitkeep

engineering/output/runs/*
!engineering/output/runs/.gitkeep

# Python 缓存（本地产物）
__pycache__/
*.pyc
.pytest_cache/
