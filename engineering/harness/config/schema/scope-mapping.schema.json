{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://androidsystemenhance.local/harness/config/scope-mapping.schema.json",
  "title": "Harness scope mapping",
  "description": "校验 scope-mapping.yaml：git commit 的 scope 判定规则。",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "配置版本号，单调递增。"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "required": ["match", "scope", "priority"],
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "string",
          "minLength": 1,
          "description": "glob 路径特征，相对仓库根。"
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "scope 词，小写字母/数字/连字符，字母开头。"
        },
        "priority": {
          "type": "integer",
          "description": "优先级，数值越大越优先；同 priority 时按数组顺序。"
        }
      }
    }
  }
}
