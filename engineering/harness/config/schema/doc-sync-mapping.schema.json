{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://androidsystemenhance.local/harness/config/doc-sync-mapping.schema.json",
  "title": "Harness doc-sync mapping",
  "description": "校验 doc-sync-mapping.yaml：patchs → 技术文档分发规则。",
  "type": "object",
  "required": ["version", "routes"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "配置版本号，单调递增。"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/route" }
    }
  },
  "definitions": {
    "route": {
      "type": "object",
      "required": ["match", "docs", "priority"],
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "string",
          "minLength": 1,
          "description": "glob 路径特征，相对 patchs/rpi5/ 根。"
        },
        "docs": {
          "type": "array",
          "description": "目标文档目录集合。fixed 模式下为确定目标；ai-diff 下为候选；ai-pending 允许为空数组。",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^docs/"
          }
        },
        "mode": {
          "type": "string",
          "enum": ["fixed", "ai-diff", "ai-pending"],
          "default": "fixed",
          "description": "分发策略：fixed 固定 / ai-diff 读 diff 选 / ai-pending 兜底待定。"
        },
        "priority": {
          "type": "integer",
          "description": "优先级，数值越大越优先；同 priority 时按数组顺序。"
        }
      }
    }
  }
}
